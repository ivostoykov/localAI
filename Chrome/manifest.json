{
    "manifest_version": 3,
    "name": "Local AI helper",
    "short_name": "localAI",
    "version": "1.31.7",
    "options_page": "options.html",
    "permissions": [
        "activeTab",
        "storage",
        "contextMenus",
        "scripting",
        "tabs",
        "offscreen"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "exclude_matches": [
                "*://chrome.google.com/*",
                "*://chrome.google.com/webstore/*"
            ],
            "js": [
                "jslib/constants.js",
                "jslib/utils.js",
                "jslib/sessions.js",
                "jslib/log.js",
                "jslib/content-cleaner.js",
                "jslib/li-extractor.js",
                "jslib/content-extractor.js",
                "jslib/host-guard.js",
                "jslib/page-snapshot.js",
                "jslib/sidebar-port.js",
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "action": {},
    "icons": {
        "16": "img/icon16.png",
        "48": "img/icon48.png",
        "128": "img/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": ["sidebar.html"],
            "matches": ["<all_urls>"],
            "use_dynamic_url": true
        }
    ]
}
